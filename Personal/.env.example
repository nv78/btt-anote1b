# Copy to .env and fill in values (Personal/.env is gitignored).
# Used by: PYTHONPATH=. python scripts/run_llm_on_dataset.py ...

# Which API to call: openai | anthropic
LLM_PROVIDER=openai

# --- OpenAI (Chat Completions) ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model id, e.g. gpt-4o-mini, gpt-4o, gpt-4.1-mini
OPENAI_MODEL=gpt-4o-mini
# Optional: Azure OpenAI or compatible proxy base URL (omit for api.openai.com)
# OPENAI_BASE_URL=

# --- Anthropic (Messages API) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Model id, e.g. claude-3-5-haiku-20241022, claude-sonnet-4-20250514
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Generation defaults (optional) ---
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=1024
