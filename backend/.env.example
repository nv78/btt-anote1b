# Copy to .env and adjust. Never commit real secrets.

# ── REQUIRED BEFORE FIRST RUN ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
LEADERBOARD_JWT_SECRET=
FLASK_SECRET_KEY=

# Google OAuth — get from console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin key for POST /api/leaderboard/seed and GET /api/admin/submissions
# Generate with: openssl rand -hex 16
LEADERBOARD_ADMIN_API_KEYS=

# Write key for POST /public/submit_model, POST /api/leaderboard/add_dataset, etc.
# Generate with: openssl rand -hex 16
LEADERBOARD_API_KEYS=

# --- Core ---
# FLASK_ENV=production
# PORT=5001
# ALLOWED_ORIGINS=https://your-frontend.example.com
# LOG_LEVEL=INFO

# --- Write auth (pick one or both) ---
# REQUIRE_API_KEY=1

# --- Optional: tokens from main Anote app (RS256/ES256) ---
# ANOTE_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
# ANOTE_ISSUER=https://your-idp.example.com
# ANOTE_AUDIENCE=leaderboard

# --- Optional: Google OAuth for contributor login ---
# Web application OAuth client (public client ID + confidential secret from Google Cloud Console).
# Redirect URI is computed per request (fixes localhost vs 127.0.0.1 mismatch).
# Register BOTH of these as Authorized redirect URIs while developing unless you stick to one host:
#   http://localhost:5001/public/auth/google/callback
#   http://127.0.0.1:5001/public/auth/google/callback
# Behind TLS reverse-proxy where Flask sees wrong Host, set canonical origin only:
# LEADERBOARD_OAUTH_PUBLIC_BASE_URL=https://api.example.com
# LEADERBOARD_FRONTEND_URL=http://localhost:3000

# --- Database (SQLite by default; MySQL optional) ---
# SQLITE_DB_PATH=./leaderboard.db
# Set to 1 in production if you manage benchmark data manually and do not want
# the app to auto-seed built-in demo/runnable datasets on first request.
# DISABLE_LEADERBOARD_AUTO_SEED=1
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=agents
# DB_PORT=3306

# --- Email notifications (optional) ---
# Submission score receipts are sent via SMTP when these are set.
# Leave blank to disable email (no error — emails are silently skipped).
#
# SendGrid (recommended):
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxx   # your SendGrid API key
#
# Gmail (dev only — use an App Password, not your login password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your-app-password
#
# SMTP_FROM=noreply@anote.ai        # sender address shown to users
# LEADERBOARD_URL=https://leaderboard.anote.ai   # link in email footer
#
# AWS SES (alternative to SMTP — preferred when AWS_SES_FROM is set):
# AWS_SES_FROM=noreply@anote.ai
# AWS_SES_REGION=us-east-1          # default: us-east-1
#
# Admin email(s) to receive dataset request alerts (comma-separated):
# LEADERBOARD_ADMIN_EMAIL=admin@anote.ai,cto@anote.ai

# --- Rate limits (all optional — sensible defaults shown) ---
# DISABLE_RATE_LIMIT=0
# SUBMIT_MODEL_RATE_LIMIT=10/minute
# ADD_DATASET_RATE_LIMIT=5/minute
# IMPORT_DATASET_RATE_LIMIT=5/minute
# RUN_HF_MODEL_RATE_LIMIT=3/minute
# RUN_CSV_RATE_LIMIT=5/minute
# QUOTA_RATE_LIMIT=30/minute
# EXPORT_RATE_LIMIT=10/minute

# --- Submission quota ---
# DAILY_SUBMISSION_LIMIT=5          # per submitter_id per UTC day; 0 = unlimited

# --- Model/provider runners (optional) ---
# Used by /public/run_llm_submission, /public/run_csv_benchmarks, and backend/models.py.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# TRUSTED_REMOTE_CODE_MODELS=          # comma-separated exact HF model ids allowed to use trust_remote_code

# --- SDK and seed scripts (optional) ---
# LEADERBOARD_API_BASE=http://127.0.0.1:5001
# LEADERBOARD_API_KEY=
# LEADERBOARD_JWT=
# SEED_DATASET_NAME=flores_spanish_translation
# SEED_MODEL_NAME=baseline-echo-seed
