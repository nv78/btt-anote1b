# Copy to .env and adjust. Never commit real secrets.

# --- Core ---
# FLASK_ENV=production
# PORT=5001
# FLASK_SECRET_KEY=change-me-long-random
# ALLOWED_ORIGINS=https://your-frontend.example.com

# --- Write auth (pick one or both) ---
# LEADERBOARD_API_KEYS=key1,key2
# REQUIRE_API_KEY=1
# LEADERBOARD_JWT_SECRET=change-me-hs256-secret

# --- Optional: tokens from main Anote app (RS256/ES256) ---
# ANOTE_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
# ANOTE_ISSUER=https://your-idp.example.com
# ANOTE_AUDIENCE=leaderboard

# --- Optional: Google OAuth for contributor login ---
# Web application OAuth client (public client ID + confidential secret from Google Cloud Console).
# GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-secret
# Redirect URI is computed per request (fixes localhost vs 127.0.0.1 mismatch).
# Register BOTH of these as Authorized redirect URIs while developing unless you stick to one host:
#   http://localhost:5001/public/auth/google/callback
#   http://127.0.0.1:5001/public/auth/google/callback
# Behind TLS reverse-proxy where Flask sees wrong Host, set canonical origin only:
# LEADERBOARD_OAUTH_PUBLIC_BASE_URL=https://api.example.com
# LEADERBOARD_FRONTEND_URL=http://localhost:3000
# HS256 secret for JWT minted after OAuth (required when OAuth is enabled):
# LEADERBOARD_JWT_SECRET=change-me-long-random

# --- Admin moderation API ---
# LEADERBOARD_ADMIN_API_KEYS=admin-secret-separate-from-write-keys

# --- Database (SQLite by default; MySQL optional) ---
# SQLITE_DB_PATH=./leaderboard.db
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=agents
# DB_PORT=3306
